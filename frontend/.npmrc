# The version rule (requirements, section 3; decided 2026-11-22): no package, direct or
# indirect, younger than two weeks (in days). It applies when the lock is resolved;
# npm ci installs the lock as it is. An urgent fix newer than that is a named exception.
#
# To re-resolve the lock, remove node_modules and package-lock.json first, then run
# npm install --package-lock-only --ignore-scripts. With node_modules present, npm writes
# the lock from the installed tree and drops the other platforms' packages.
min-release-age=14
