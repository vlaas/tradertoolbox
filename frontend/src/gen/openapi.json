      "RestStatus": {
        "description": "The state of the REST connection, for the status bar and the health route (BRK-09).\n\n``auth`` is one of:\n\n- ``none``: no access token yet; the first call fetches one.\n- ``valid``: a token is held with more than the renewal margin (60 s) left.\n- ``due``: the token is inside the margin; the next call renews it first.\n- ``lapsed``: the token has expired while nothing was called; the next call renews it.\n  This is normal after a quiet spell, because renewal happens on use.\n- ``renewing``: a renewal is under way.\n- ``refused``: the broker refused the grant, or the grant has more than read scope.\n  No call is made until the backend is restarted with a new grant; ``refusal`` says why.",
        "properties": {
          "auth": {
            "$ref": "#/components/schemas/AuthState"
          },
          "burst": {
            "title": "Burst",
            "type": "integer"
          },
          "held_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Held Until"
          },
          "last_renewal_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Renewal At"
          },
          "rate": {
            "title": "Rate",
            "type": "number"
          },
          "rate_limited": {
            "title": "Rate Limited",
            "type": "integer"
          },
          "refusal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refusal"
          },
          "renewals": {
            "title": "Renewals",
            "type": "integer"
          },
          "renews_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Renews From"
          },
          "requests_last_minute": {
            "title": "Requests Last Minute",
            "type": "integer"
          },
          "token_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Expires At"
